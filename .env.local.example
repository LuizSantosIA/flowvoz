# PostgreSQL (mesmo banco do n8n)
DATABASE_URL=postgresql://usuario:senha@localhost:5432/n8n

# Evolution API (atual)
EVO_URL=https://sua-evolution.com
EVO_INSTANCE=nome-instancia
EVO_APIKEY=sua-apikey

# WhatsApp provider: "evolution" | "meta"
WA_PROVIDER=evolution

# Meta WhatsApp Business API
META_TOKEN=seu_access_token_permanente
META_PHONE_NUMBER_ID=id_do_numero_de_telefone
META_BUSINESS_ACCOUNT_ID=id_da_conta_business
META_VERIFY_TOKEN=token_secreto_que_voce_escolhe
META_APP_SECRET=secret_do_app_meta

# Webhook do n8n (para onde o adaptador encaminha as mensagens)
N8N_WEBHOOK_URL=https://seu-n8n.com/webhook/venda-direta
