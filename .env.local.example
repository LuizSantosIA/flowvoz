# ===== Login do painel =====
# Senha única de acesso ao painel. Se não setar, o painel fica aberto.
PANEL_PASSWORD=algumaSenhaForte

# Segredo pra assinar o cookie de sessão (HMAC). Recomendado. Se vazio, usa PANEL_PASSWORD.
SESSION_SECRET=outraStringAleatoria

# Nome exibido no rodapé da sidebar. Padrão: "FlowVoz"
NEXT_PUBLIC_COMPANY_NAME=Venda Direta MG

# ===== Banco (Neon Postgres) =====
DATABASE_URL=postgresql://user:senha@host/db?sslmode=require
DATABASE_SSL=true

# ===== WhatsApp =====
# Provedor padrão (fallback quando a caixa não está cadastrada): "evolution" | "meta"
WA_PROVIDER=evolution

# ===== Evolution API (se for usar) =====
EVO_URL=https://sua-evolution.com        # SEM barra no fim
EVO_INSTANCE=nome-instancia
EVO_APIKEY=sua-apikey

# Segredo do webhook da Evolution. Se setado, exige ?secret=... na URL.
WEBHOOK_SECRET=stringSecretaAleatoria

# ===== Meta WhatsApp Business / Cloud API (se for usar) =====
META_TOKEN=seu_token
META_PHONE_NUMBER_ID=id_do_numero
META_VERIFY_TOKEN=token_secreto_que_voce_escolhe
META_APP_SECRET=secret_do_app_meta
